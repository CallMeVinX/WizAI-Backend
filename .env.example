# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and provide your actual credentials:
# cp .env.example .env
# ==============================================================================

# Database connection (matches default credentials in docker-compose.yml)
# If using local native PostgreSQL, adjust user/password/host as needed.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wizzai_leads

# AI credentials (optional for testing, required for live LLM features)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# CORS Origins (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Pagination Defaults (optional - defaults defined in app/config.py)
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# Deduplication Tuning Thresholds (optional - defaults defined in app/config.py)
DEDUPE_CONFIDENCE_THRESHOLD=0.6
DEDUPE_LLM_THRESHOLD=0.8
DEDUPE_LLM_MAX_PAIRS=5
